    "Cues play over your music. With every sound off, the app never touches your audio.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signale werden über deiner Musik abgespielt. Sind alle Töne aus, greift die App nie auf dein Audio zu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avisos suenan sobre tu música. Con todos los sonidos desactivados, la app no toca tu audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les signaux se jouent par-dessus votre musique. Si tous les sons sont coupés, l'app ne touche jamais à votre audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I segnali suonano sopra la tua musica. Con tutti i suoni disattivati, l'app non tocca mai il tuo audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合図は音楽に重ねて再生されます。すべてのサウンドをオフにすると、アプリはオーディオに一切触れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신호는 음악 위에 재생됩니다. 모든 소리를 끄면 앱은 오디오를 전혀 건드리지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Signalen spelen over je muziek heen. Met alle geluiden uit komt de app niet aan je audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sinais tocam junto com a sua música. Com todos os sons desativados, o app não mexe no seu áudio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигналы звучат поверх музыки. Если выключить все звуки, приложение не трогает ваше аудио."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Signalerna spelas ovanpå din musik. Med alla ljud av rör appen aldrig ditt ljud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัญญาณจะเล่นซ้อนเพลงของคุณ เมื่อปิดเสียงทั้งหมด แอปจะไม่ยุ่งกับเสียงของคุณเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarılar müziğinizin üzerine çalar. Tüm sesler kapalıyken uygulama sesinize hiç dokunmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示会叠加在音乐上播放。关闭所有声音后，App 不会触碰你的音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示會疊加在音樂上播放。關閉所有聲音後，App 不會動到你的音訊。"
          }
        }
      }
    },
