    "Free forever. No ads, no subscriptions, no tracking. Your workouts stay on your device.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für immer kostenlos. Keine Werbung, keine Abos, kein Tracking. Deine Trainings bleiben auf deinem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis para siempre. Sin anuncios, sin suscripciones, sin rastreo. Tus entrenamientos se quedan en tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit pour toujours. Sans publicité, sans abonnement, sans pistage. Vos entraînements restent sur votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis per sempre. Niente pubblicità, abbonamenti o tracciamento. I tuoi allenamenti restano sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ずっと無料。広告なし、サブスクなし、トラッキングなし。ワークアウトはデバイスの中だけに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영원히 무료. 광고, 구독, 추적 없음. 운동 기록은 기기에만 저장됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor altijd gratis. Geen advertenties, geen abonnementen, geen tracking. Je trainingen blijven op je apparaat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis para sempre. Sem anúncios, sem assinaturas, sem rastreamento. Seus treinos ficam no seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатно навсегда. Без рекламы, подписок и отслеживания. Тренировки хранятся только на вашем устройстве."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis för alltid. Ingen reklam, inga prenumerationer, ingen spårning. Dina pass stannar på din enhet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟรีตลอดไป ไม่มีโฆษณา ไม่มีการสมัครสมาชิก ไม่มีการติดตาม ข้อมูลการออกกำลังกายอยู่ในอุปกรณ์ของคุณเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonsuza dek ücretsiz. Reklam yok, abonelik yok, izleme yok. Antrenmanlarınız cihazınızda kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久免费。无广告、无订阅、无追踪。你的训练只保存在设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久免費。無廣告、無訂閱、無追蹤。你的訓練只儲存在裝置上。"
          }
        }
      }
    },
