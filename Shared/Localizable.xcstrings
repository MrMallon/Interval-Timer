    "Sends a small file with this timer's intervals. Your history and settings stay on your iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet eine kleine Datei mit den Intervallen dieses Timers. Verlauf und Einstellungen bleiben auf deinem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía un archivo pequeño con los intervalos de este temporizador. Tu historial y tus ajustes se quedan en tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie un petit fichier avec les intervalles de ce minuteur. Votre historique et vos réglages restent sur votre iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia un piccolo file con gli intervalli di questo timer. Cronologia e impostazioni restano sul tuo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このタイマーのインターバルを含む小さなファイルを送信します。履歴と設定は iPhone に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 타이머의 구간이 담긴 작은 파일을 보냅니다. 기록과 설정은 iPhone에 그대로 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstuurt een klein bestand met de intervallen van deze timer. Je geschiedenis en instellingen blijven op je iPhone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia um arquivo pequeno com os intervalos deste timer. Seu histórico e seus ajustes ficam no iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляет небольшой файл с интервалами этого таймера. История и настройки остаются на вашем iPhone."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skickar en liten fil med den här timerns intervaller. Din historik och dina inställningar stannar på din iPhone."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งไฟล์ขนาดเล็กที่มีช่วงเวลาของตัวจับเวลานี้ ประวัติและการตั้งค่าของคุณจะยังอยู่ใน iPhone"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu zamanlayıcının aralıklarını içeren küçük bir dosya gönderir. Geçmişiniz ve ayarlarınız iPhone’unuzda kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送一个包含此计时器间隔的小文件。你的历史记录和设置会保留在 iPhone 上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傳送一個包含此計時器間隔的小檔案。你的歷史記錄和設定會保留在 iPhone 上。"
          }
        }
      }
    },
    "Set each interval yourself: pyramids, ladders, named exercises, repeat groups." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege jedes Intervall selbst fest: Pyramiden, Leitern, benannte Übungen, Wiederholungsgruppen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura cada intervalo: pirámides, escaleras, ejercicios con nombre, grupos repetidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez chaque intervalle vous-même : pyramides, échelles, exercices nommés, groupes répétés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta ogni intervallo: piramidi, scale, esercizi con nome, gruppi ripetuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターバルを1つずつ設定：ピラミッド、ラダー、名前付きの種目、繰り返しグループ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터벌을 하나씩 직접 설정: 피라미드, 래더, 이름 있는 운동, 반복 그룹."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel elk interval zelf in: piramides, ladders, oefeningen met naam, herhaalgroepen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
