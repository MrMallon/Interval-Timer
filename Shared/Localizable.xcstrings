    "A cycle is one full set of rounds. Repeat it with a longer rest in between.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Zyklus ist ein kompletter Satz Runden. Wiederhole ihn mit einer längeren Pause dazwischen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ciclo es una serie completa de rondas. Repítelo con un descanso más largo entre medias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cycle est une série complète de rounds. Répétez-le avec un repos plus long entre chaque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ciclo è una serie completa di round. Ripetilo con un recupero più lungo in mezzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイクルはラウンドのひとまとまりです。長めの休憩をはさんで繰り返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이클은 라운드 한 세트 전체입니다. 사이에 더 긴 휴식을 두고 반복하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een cyclus is één volledige reeks rondes. Herhaal hem met een langere rust ertussen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ciclo é uma série completa de rounds. Repita com um descanso maior entre eles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цикл — это полный набор раундов. Повторяйте его с более долгим отдыхом между циклами."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En cykel är en hel uppsättning ronder. Upprepa den med längre vila emellan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอบใหญ่คือชุดยกทั้งหมดหนึ่งชุด ทำซ้ำได้โดยพักนานขึ้นระหว่างรอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Döngü, rauntların tam bir setidir. Arada daha uzun dinlenerek tekrarlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个循环就是一整组回合。重复时中间可以休息更久。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個循環就是一整組回合。重複時中間可以休息久一點。"
          }
        }
      }
    },
