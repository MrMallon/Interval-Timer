    "Create your own or start from a preset like Tabata or boxing rounds.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle einen eigenen Timer oder starte mit einer Vorlage wie Tabata oder Boxrunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea el tuyo o empieza con una plantilla como Tabata o rondas de boxeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez le vôtre ou partez d'un préréglage comme Tabata ou des rounds de boxe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea il tuo timer o parti da un preset come Tabata o round di boxe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で作成するか、タバタやボクシングラウンドなどのプリセットから始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 만들거나 타바타, 복싱 라운드 같은 프리셋으로 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak je eigen timer of begin met een voorinstelling zoals Tabata of bokspartijen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie o seu ou comece com uma predefinição como Tabata ou rounds de boxe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте свой таймер или начните с шаблона, например Табата или боксёрские раунды."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en egen eller börja med ett förval som Tabata eller boxningsronder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างเอง หรือเริ่มจากค่าที่ตั้งไว้ เช่น ทาบาตะ หรือยกมวย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi zamanlayıcınızı oluşturun veya Tabata, boks rauntları gibi bir hazır ayarla başlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自己创建，或从 Tabata、拳击回合等预设开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自行建立，或從 Tabata、拳擊回合等預設開始。"
          }
        }
      }
    },
