    "With a time cap the workout ends by itself if you haven't tapped Done." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Zeitlimit endet das Training von selbst, wenn du nicht auf Fertig getippt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con límite de tiempo, el entreno termina solo si no has tocado OK."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec une limite, l'entraînement s'arrête seul si vous n'avez pas touché Terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un limite di tempo l'allenamento finisce da solo se non hai toccato Fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制限時間を設けると、「完了」をタップしなくても時間になれば終わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제한 시간이 있으면 완료를 탭하지 않아도 시간이 되면 운동이 끝납니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met een tijdslimiet stopt de training vanzelf als je nog niet op Gereed hebt getikt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com limite de tempo, o treino termina sozinho se você não tiver tocado em OK."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С лимитом времени тренировка закончится сама, если вы не нажали «Готово»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med tidsgräns avslutas passet av sig självt om du inte har tryckt på Klar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อจำกัดเวลา การออกกำลังกายจะจบเองหากคุณยังไม่ได้แตะเสร็จสิ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Süre sınırı varsa, Bitti'ye dokunmasan da antrenman kendiliğinden biter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置限时后，即使你没有轻点“完成”，时间一到训练也会自动结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定限時後，即使你沒有點一下「完成」，時間一到訓練也會自動結束。"
          }
        }
      }
    },
