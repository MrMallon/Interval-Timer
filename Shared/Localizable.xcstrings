    "Runs until you tap Done. The clock counts up." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft, bis du auf Fertig tippst. Die Uhr zählt hoch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue hasta que toques OK. El reloj cuenta hacia arriba."
          }
